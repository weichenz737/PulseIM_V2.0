# Copy to deploy/.env on the production host. Never commit the real values.
# Generate strong random values, for example: openssl rand -base64 48
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-48-random-characters
TURN_CREDENTIAL=replace-with-a-long-random-turn-password
# Comma-separated. Include the public web origin and Capacitor origin used by the app.
CORS_ALLOWED_ORIGINS=https://your-domain.example,https://localhost,capacitor://localhost

# Optional production integrations
BAIDU_MAP_AK=
BAIDU_MAP_APP_AK=

# WPS WebOffice 页内预览（需先在 WPS 开放平台创建并审核应用）
WPS_WEBOFFICE_ENABLED=false
WPS_WEBOFFICE_APP_ID=
WPS_WEBOFFICE_APP_SECRET=
WPS_WEBOFFICE_PUBLIC_BASE_URL=https://your-domain.example
WPS_WEBOFFICE_TOKEN_SECRET=replace-with-a-different-long-random-secret
WPS_WEBOFFICE_SDK_URL=/vendor/wps/web-office-sdk-solution.umd.js
PULSE_DOCUMENT_PREVIEW_ENABLED=true
LIBREOFFICE_PATH=soffice
PULSE_DOCUMENT_PREVIEW_MAX_SOURCE_BYTES=104857600
PULSE_DOCUMENT_PREVIEW_TIMEOUT_SECONDS=90
