{
  "name": "pulse-desktop",
  "version": "1.5.42",
  "private": true,
  "description": "Pulse desktop web and Windows/macOS client",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ..\\mobile\\node_modules\\vite\\bin\\vite.js",
    "build": "node ..\\mobile\\node_modules\\vite\\bin\\vite.js build",
    "build:electron": "cross-env VITE_ELECTRON_BUILD=1 npm run build",
    "preview": "node ..\\mobile\\node_modules\\vite\\bin\\vite.js preview",
    "electron:dev": "node electron/dev.cjs",
    "package:win": "npm run build:electron && electron-forge make --platform=win32",
    "package:mac": "npm run build:electron && electron-forge make --platform=darwin"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
