{
  "name": "pulse-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:native": "vue-tsc -b && vite build --mode native",
    "cap:copy:android": "npm run build:native && cap copy android",
    "cap:sync:android": "npm run build:native && cap sync android",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run cap:sync:android && cap run android",
    "android:build": "npm run cap:sync:android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run cap:sync:android && cd android && gradlew.bat clean assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@vant/area-data": "^2.1.0",
    "axios": "^1.7.9",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vant": "^4.9.15",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
